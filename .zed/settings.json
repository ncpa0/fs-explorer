{
  "format_on_save": "on",
  "languages": {
    "JavaScript": {
      "language_servers": ["!eslint", "typescript-language-server"]
    },
    "TypeScript": {
      "language_servers": ["!eslint", "typescript-language-server"],
      "formatter": {
        "external": {
          "command": "dprint",
          "arguments": ["fmt", "--stdin", "{buffer_path}"]
        }
      },
      "code_actions_on_format": {
        "source.removeUnusedImports": true
      }
    },
    "TSX": {
      "language_servers": ["!eslint", "typescript-language-server"],
      "formatter": {
        "external": {
          "command": "dprint",
          "arguments": ["fmt", "--stdin", "{buffer_path}"]
        }
      },
      "code_actions_on_format": {
        "source.removeUnusedImports": true
      }
    },
    "CSS": {
      "formatter": {
        "external": {
          "command": "dprint",
          "arguments": ["fmt", "--stdin", "{buffer_path}"]
        }
      }
    },
    "JSON": {
      "formatter": {
        "external": {
          "command": "dprint",
          "arguments": ["fmt", "--stdin", "{buffer_path}"]
        }
      }
    }
  },
  "lsp": {
    "eslint": {}
  }
}
