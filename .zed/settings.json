{
  "languages": {
    "JavaScript": {
      "language_servers": ["!eslint", "..."]
    },
    "TypeScript": {
      "language_servers": ["!eslint", "..."],
      "format_on_save": {
        "external": {
          "command": "bun",
          "arguments": ["run", "dprint", "fmt", "--stdin", "{buffer_path}"]
        }
      },
      "code_actions_on_format": {
        "source.organizeImports": true
      }
    },
    "TSX": {
      "language_servers": ["!eslint", "..."],
      "format_on_save": {
        "external": {
          "command": "bun",
          "arguments": ["run", "dprint", "fmt", "--stdin", "{buffer_path}"]
        }
      },
      "code_actions_on_format": {
        "source.organizeImports": true
      }
    },
    "CSS": {
      "format_on_save": {
        "external": {
          "command": "bun",
          "arguments": ["run", "dprint", "fmt", "--stdin", "{buffer_path}"]
        }
      }
    },
    "JSON": {
      "format_on_save": {
        "external": {
          "command": "bun",
          "arguments": ["run", "dprint", "fmt", "--stdin", "{buffer_path}"]
        }
      }
    }
  },
  "lsp": {
    "eslint": {}
  }
}
